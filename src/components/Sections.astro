  <div class="rounded-3xl border border-slate-200 bg-white p-6 text-center shadow-sm md:p-10">
    <h2 class="font-bold">Partners &amp; Scientific Endorsers</h2>
    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {partners.map((p) => (
        <div class="rounded-xl bg-slate-100 p-4"><p class="font-extrabold">{p.name}</p><p class="text-[11px] uppercase text-slate-500">{p.desc}</p></div>
      ))}
    </div>
  </div>
</section>-->
