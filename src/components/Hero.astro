---
import { site, links } from '../data/site.js';
---
<section id="top" aria-labelledby="hero-title" class="mx-auto max-w-6xl px-5 pb-10 pt-12 md:pt-20">
  <div class="mx-auto w-full max-w-4xl text-center">
    <p class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-widest text-[#0B1F3A]">
      <span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-[#155EEF]"></span>
      Seminar Nasional 2026
    </p>

    <h1 id="hero-title" class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-[#0B1F3A] md:text-5xl">
      {site.fullTitle}
    </h1>

    <p class="mt-3 text-lg font-semibold text-[#155EEF]">{site.theme}</p>

    <ul aria-label="Informasi pelaksanaan" class="mt-5 flex flex-wrap items-center justify-center gap-2 text-sm">
      <li class="rounded-lg bg-white px-3 py-2 shadow-sm">📅 {site.dates}</li>
      <li class="rounded-lg bg-white px-3 py-2 shadow-sm">📍 {site.city}</li>
      <li class="rounded-lg bg-blue-50 px-3 py-2 font-medium">Onsite ({site.venueShort})</li>
    </ul>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href={links.submitPaper}
        target="_blank"
        rel="noopener"
        class="rounded-lg bg-[#155EEF] px-6 py-3 text-sm font-semibold text-white shadow transition-colors hover:bg-[#0B1F3A] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#155EEF]"
      >
        Submit Paper
      </a>
      <a
        href={links.registration}
        target="_blank"
        rel="noopener"
        class="rounded-lg bg-white px-6 py-3 text-sm font-semibold text-[#0B1F3A] shadow transition-colors hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#155EEF]"
      >
        Register Now
      </a>
    </div>

    <div class="mx-auto mt-6 w-full max-w-xl rounded-xl border border-slate-200 bg-white p-4 shadow">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Call for Papers</p>
      <p class="mt-1 font-semibold text-[#0B1F3A]">Submission Deadline: {site.deadline}</p>
    </div>
  </div>
</section>
