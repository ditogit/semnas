---
<div id="install-banner" class="fixed bottom-4 left-4 right-4 z-50 mx-auto hidden max-w-md rounded-2xl border border-slate-200 bg-white p-4 shadow-xl">
  <p class="text-sm font-bold text-[#0B1F3A]">Install aplikasi SemNas?</p>
  <p class="text-xs text-slate-500">Akses jadwal &amp; info venue offline.</p>
  <div class="mt-3 flex gap-2">
    <button id="install-btn" type="button" class="flex-1 rounded-lg bg-[#155EEF] px-4 py-2 text-sm font-semibold text-white">Install</button>
    <button id="install-dismiss" type="button" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold">Nanti</button>
  </div>
</div>
<script>
  let deferredPrompt = null;
  const banner = document.getElementById('install-banner');
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    banner.classList.remove('hidden');
  });
  document.getElementById('install-btn')?.addEventListener('click', async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    await deferredPrompt.userChoice;
    deferredPrompt = null;
    banner.classList.add('hidden');
  });
  document.getElementById('install-dismiss')?.addEventListener('click', () => {
    banner.classList.add('hidden');
  });
</script>
